@echo off
if "%~1"=="" (
    echo [EROARE] Specificati calea folderului lectiei din 05_materiale.
    echo Utilizare: sincronizeaza_lectie.bat "D:\01.WorkspaceCLAUDE\echipa-didactica-constructie\05_materiale\2026-2027\clasa-IX\CAIP-Ochiul-electronistului\CAIP-Z2-tensiune-curent-ohm"
    exit /b 1
)
set "LECTIE_SURSA=%~1"
set "PORTAL_ROOT=%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$sursa = [System.IO.Path]::GetFullPath($env:LECTIE_SURSA); $portalRoot = [System.IO.Path]::GetFullPath($env:PORTAL_ROOT); if (-not (Test-Path -LiteralPath $sursa -PathType Container)) { Write-Error ('Folderul sursa nu exista: ' + $sursa); exit 1 }; if ($sursa -match '(?i)[\\/]profesor([\\/]|$)') { Write-Error 'Directorul iesire/profesor este restrictionat si ignorat.'; exit 1 }; $parts = $sursa -split '[\\/]'; $idxClasa = -1; for ($i=0; $i -lt $parts.Length; $i++) { if ($parts[$i] -imatch '^clasa-') { $idxClasa = $i; break } }; if ($idxClasa -ge 0) { $relParts = $parts[$idxClasa..($parts.Length-1)] } else { $relParts = $parts[-3..-1] }; $lastFolder = $relParts[-1]; if ($lastFolder -match '^([A-Za-z0-9]+-[A-Za-z]*\d+)(?:-.+)?$') { $relParts[-1] = $Matches[1] }; $dest = Join-Path $portalRoot ($relParts -join '\'); New-Item -ItemType Directory -Force -Path $dest | Out-Null; Write-Host '========================================================================'; Write-Host '[SINCRONIZARE LECTIE IN PORTAL-ELEVI]'; Write-Host ('  Sursa productie   : ' + $sursa); Write-Host ('  Destinatie portal : ' + $dest); Write-Host '  Politica profesor : iesire/profesor/ -> IGNORAT COMPLET'; Write-Host '------------------------------------------------------------------------'; $count = 0; $simPath = Join-Path $sursa 'simulari\simulator.html'; if (Test-Path -LiteralPath $simPath -PathType Leaf) { $destSim = Join-Path $dest 'simulator.html'; Copy-Item -LiteralPath $simPath -Destination $destSim -Force; $count++; Write-Host ('  [OK] Simulator copiat : ' + $destSim) } else { Write-Host ('  [INFO] Nu exista simulator la: ' + $simPath) }; $elevDir = Join-Path $sursa 'iesire\elev'; if (Test-Path -LiteralPath $elevDir -PathType Container) { $pdfs = Get-ChildItem -LiteralPath $elevDir -Filter '*.pdf' -File; foreach ($p in $pdfs) { $destPdf = Join-Path $dest $p.Name; Copy-Item -LiteralPath $p.FullName -Destination $destPdf -Force; $count++; Write-Host ('  [OK] PDF Elev copiat  : ' + $destPdf) } } else { Write-Host ('  [INFO] Nu exista directorul iesire\elev la: ' + $elevDir) }; Write-Host '------------------------------------------------------------------------'; Write-Host ('[FINALIZAT] Total fisiere sincronizate: ' + $count); Write-Host '========================================================================'"
